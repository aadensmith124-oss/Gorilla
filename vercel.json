{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!api(?:/|$)|assets(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}